# Skopiuj do .env.local (lokalnie) lub ustaw w Cloudflare Pages → Settings → Variables.
# JAVA_RUNNER=local                       # tylko `npm run dev`: kompiluj lokalnym JDK
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_KEY=                             # klucz RapidAPI (tryb proxy)
# JUDGE0_AUTH_TOKEN=                      # token własnej instancji Judge0 (tryb proxy)
# JAVA_LANGUAGE_ID=62
# ACCESS_CODE=                            # kod dołączany do linku kandydata
